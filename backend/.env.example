# Django development configuration
DEBUG=1
SECRET_KEY=dev-only-change-this-secret
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL empty for the local SQLite fallback.
# Docker Compose supplies a PostgreSQL URL at runtime.
DATABASE_URL=
REDIS_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Optional integrations; enable only when their adapter is implemented.
CLOUDINARY_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SENTRY_DSN=
